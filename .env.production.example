# Raktakk Backend - Render production environment template
# Copy these values into Render > Environment and replace every placeholder.

SPRING_PROFILES_ACTIVE=prod
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Render injecte souvent DATABASE_URL depuis la base liée.
# Si tu préfères des variables Spring explicites, renseigne aussi ces 3 lignes.
SPRING_DATASOURCE_URL=jdbc:postgresql://<render-postgres-host>:5432/<database>
SPRING_DATASOURCE_USERNAME=<database-user>
SPRING_DATASOURCE_PASSWORD=<database-password>

# Génère deux secrets différents, par exemple avec: openssl rand -base64 32
JWT_SECRET=<base64-secret-1>
JWT_REFRESH_SECRET=<base64-secret-2>

JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=1209600000

REFRESH_COOKIE_NAME=raktakk_refresh_token
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAME_SITE=Strict

REQUIRE_HTTPS=true
SECURITY_CSP=default-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self';

# Mets ici l'URL exacte de ton frontend, séparée par virgule si besoin.
CORS_ALLOWED_ORIGINS=https://<frontend-domain>.onrender.com,https://<frontend-custom-domain>

# URL de retour OAuth2 côté frontend.
OAUTH2_SUCCESS_REDIRECT_URI=https://<frontend-domain>.onrender.com/oauth2/success

# SMTP de ton fournisseur mail.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<your-email@gmail.com>
MAIL_PASSWORD=<smtp-app-password>
MAIL_FROM=support@raktakk.com
MAIL_ADMIN=admin@raktakk.com

# OAuth2 Google.
GOOGLE_CLIENT_ID=<google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<google-client-secret>

# UnitechPay.
UNITECH_API_BASE=https://api.unitech.sn/api.php
UNITECH_API_KEY=<unitech-api-key>
UNITECH_CALLBACK_BASE=https://<backend-domain>.onrender.com
